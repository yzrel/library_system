    "react-dom": "18.3.1",
    "sonner": "2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "26.1.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.1.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "6.3.5",
    "vitest": "4.1.10"
