{
  "name": "vfgnhs-library-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
